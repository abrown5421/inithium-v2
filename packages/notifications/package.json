    },
    "./react": {
      "@inithium/source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "neverthrow": "^8.2.0",
    "@inithium/pubsub": ">=0.1.0",
    "@inithium/store": ">=0.1.0",
