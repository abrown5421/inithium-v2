{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "vite/**/*.spec.ts"],
  "references": [
    {
      "path": "../types/tsconfig.lib.json"
    },
    {
      "path": "../crud-engine/tsconfig.lib.json"
    },
    {
      "path": "../models/tsconfig.lib.json"
    },
    {
      "path": "../validators/tsconfig.lib.json"
    },
    {
      "path": "../pages/tsconfig.lib.json"
    },
    {
      "path": "../pubsub/tsconfig.lib.json"
    },
    {
      "path": "../store/tsconfig.lib.json"
    }
  ]
}
