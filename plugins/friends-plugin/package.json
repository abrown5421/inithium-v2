{
  "name": "@inithium/friends-plugin",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "inithium": {
    "plugin": true
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@inithium/plugin-engine": ">=0.0.1",
    "@inithium/ui": ">=0.0.1",
    "@inithium/pages": ">=0.0.1",
    "@inithium/store": ">=0.0.1",
    "@inithium/pubsub": ">=0.0.1",
    "@inithium/types": ">=0.0.1",
    "@inithium/db": ">=0.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "zod": "^4.4.3",
    "lucide-react": "^1.27.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "~6.0.3",
    "@types/react": "^19.0.0",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@inithium/auth": "*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  }
}
